# ========================================================
# TOKOCRYPTO AI TRADING BOT - ENVIRONMENT CONFIGURATION
# ========================================================
# Jika deploy di Railway: Masukkan variabel ini di tab "Variables"
# Jika dijalankan secara lokal: Salin file ini menjadi ".env"

# --- PORT SERVER ---
PORT=3456

# --- MODE TRADING & PAIR ---
# BOT_MODE: "paper" (simulasi saldo virtual) atau "live" (uang riil Tokocrypto)
BOT_MODE=paper
SYMBOL=BTCUSDT
INTERVAL=5m

# --- AI VALIDATOR (Ollama / Groq / Gemini / OpenAI) ---
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
# Endpoint Ollama (gunakan domain Railway Ollama Anda tanpa /api/chat atau dengan /api/chat):
AI_ENDPOINT=https://bootoh-ai-developmet.up.railway.app
# API Key AI (Hanya jika pakai Groq / Gemini / OpenAI):
AI_API_KEY=

# --- TOKOCRYPTO API CREDENTIALS (Wajib untuk Mode Live) ---
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_API_SECRET=

# --- NOTIFIKASI DISCORD (Opsional) ---
DISCORD_WEBHOOK_URL=

# --- KONFIGURASI SMTP EMAIL (KIRIM & RESET PIN) ---
# Contoh untuk Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465 (SSL direct) atau 587 (STARTTLS)
# SMTP_SECURE=true
# SMTP_USER=emailanda@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx (Gunakan Google App Password 16 karakter, bukan password akun)
# SMTP_FROM=emailanda@gmail.com
# SMTP_TO=tujuan@email.com (Email yang akan menerima PIN baru)

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
